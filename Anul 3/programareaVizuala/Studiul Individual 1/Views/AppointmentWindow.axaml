<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="BarberDesk.Views.AppointmentWindow"
    Title="Programare nouă"
    Width="580"
    Height="760"
    MinWidth="520"
    MinHeight="580"
    WindowStartupLocation="CenterOwner"
    >
    <DockPanel
        Margin="24"
        >
        <StackPanel
            DockPanel.Dock="Bottom"
            Spacing="12"
            Margin="0,16,0,0"
            >
            <TextBlock
                x:Name="ErrorText"
                Classes="error"
                IsVisible="False"
                />
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                >
                <Button
                    x:Name="CancelButton"
                    Content="Renunță"
                    Click="Cancel_Click"
                    />
                <Button
                    x:Name="SaveButton"
                    Content="Salvează"
                    Classes="primary"
                    Click="Save_Click"
                    />
            </StackPanel>
        </StackPanel>
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            >
            <StackPanel
                Spacing="12"
                >
                <TextBlock
                    x:Name="HeadingText"
                    Text="Programare nouă"
                    Classes="heading"
                    />
                <TextBlock
                    Text="Completați datele clientului și ora vizitei."
                    />
                <StackPanel
                    Spacing="4"
                    >
                    <TextBlock
                        Text="Numele clientului"
                        />
                    <TextBox
                        x:Name="ClientBox"
                        MaxLength="80"
                        PlaceholderText="Ex.: Ion Rusu"
                        />
                </StackPanel>
                <StackPanel
                    Spacing="4"
                    >
                    <TextBlock
                        Text="Telefon"
                        />
                    <TextBox
                        x:Name="PhoneBox"
                        MaxLength="16"
                        PlaceholderText="Ex.: 060000001"
                        />
                </StackPanel>
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    >
                    <StackPanel
                        Spacing="4"
                        >
                        <TextBlock
                            Text="Frizer"
                            />
                        <ComboBox
                            x:Name="BarberBox"
                            HorizontalAlignment="Stretch"
                            />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="4"
                        >
                        <TextBlock
                            Text="Ora (HH:mm)"
                            />
                        <TextBox
                            x:Name="TimeBox"
                            Text="09:00"
                            MaxLength="5"
                            />
                    </StackPanel>
                </Grid>
                <StackPanel
                    Spacing="4"
                    >
                    <TextBlock
                        Text="Serviciu, durată și preț"
                        />
                    <ComboBox
                        x:Name="ServiceBox"
                        HorizontalAlignment="Stretch"
                        />
                </StackPanel>
                <StackPanel
                    Spacing="4"
                    >
                    <TextBlock
                        Text="Data"
                        />
                    <DatePicker
                        x:Name="AppointmentDate"
                        />
                </StackPanel>
                <!--  Border și StackPanel formează un grup cu titlu pentru RadioButton.  -->
                <Border
                    BorderBrush="#CCD8D2"
                    BorderThickness="1"
                    Padding="12"
                    >
                    <StackPanel
                        Spacing="6"
                        >
                        <TextBlock
                            Text="Starea programării"
                            FontWeight="SemiBold"
                            />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="15"
                            >
                            <RadioButton
                                x:Name="ScheduledRadio"
                                GroupName="Status"
                                Content="Programată"
                                IsChecked="True"
                                />
                            <RadioButton
                                x:Name="CompletedRadio"
                                GroupName="Status"
                                Content="Finalizată"
                                />
                            <RadioButton
                                x:Name="CancelledRadio"
                                GroupName="Status"
                                Content="Anulată"
                                />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel
                    Spacing="4"
                    >
                    <TextBlock
                        Text="Observații (opțional)"
                        />
                    <TextBox
                        x:Name="NotesBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="75"
                        MaxLength="500"
                        />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
