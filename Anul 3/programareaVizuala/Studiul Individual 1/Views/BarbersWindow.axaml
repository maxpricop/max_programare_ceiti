<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="BarberDesk.Views.BarbersWindow"
    Title="Frizeri"
    Width="650"
    Height="420"
    MinWidth="600"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    >
    <DockPanel
        Margin="24"
        >
        <StackPanel
            DockPanel.Dock="Top"
            Spacing="6"
            Margin="0,0,0,20"
            >
            <TextBlock
                Text="Frizeri"
                Classes="heading"
                />
            <TextBlock
                Text="Adăugați sau corectați numele frizerilor. Programul este 09:00–18:00 pentru toți."
                TextWrapping="Wrap"
                />
        </StackPanel>
        <StackPanel
            DockPanel.Dock="Bottom"
            Spacing="10"
            Margin="0,15,0,0"
            >
            <TextBlock
                x:Name="ErrorText"
                Classes="error"
                />
            <Button
                Content="Închide"
                Click="Close_Click"
                HorizontalAlignment="Right"
                />
        </StackPanel>
        <Grid
            ColumnDefinitions="*,270"
            ColumnSpacing="20"
            >
            <ListBox
                x:Name="BarberList"
                Background="White"
                SelectionChanged="BarberList_Changed"
                />
            <StackPanel
                Grid.Column="1"
                Spacing="12"
                >
                <TextBlock
                    x:Name="EditorTitle"
                    Text="Frizer nou"
                    FontWeight="SemiBold"
                    />
                <TextBox
                    x:Name="NameBox"
                    PlaceholderText="Numele frizerului"
                    MaxLength="60"
                    />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    >
                    <Button
                        x:Name="SaveButton"
                        Content="Salvează"
                        Classes="primary"
                        Click="Save_Click"
                        />
                    <Button
                        x:Name="NewButton"
                        Content="Nou"
                        Click="New_Click"
                        />
                </StackPanel>
                <Button
                    x:Name="DeleteButton"
                    Content="Șterge frizerul"
                    IsEnabled="False"
                    Click="Delete_Click"
                    />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
