<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BarberDesk.Models"
    x:Class="BarberDesk.Views.MainWindow"
    Title="Tura • Programări la frizerie"
    Width="1000"
    Height="770"
    MinWidth="850"
    MinHeight="650"
    >
    <DockPanel>
        <Menu
            DockPanel.Dock="Top"
            >
            <MenuItem
                Header="_Programări"
                >
                <MenuItem
                    x:Name="ExportMenu"
                    Header="Exportă lista în CSV..."
                    Click="Export_Click"
                    />
                <MenuItem
                    x:Name="ResetMenu"
                    Header="Resetează filtrele la ziua de azi"
                    Click="Reset_Click"
                    />
            </MenuItem>
            <MenuItem
                Header="_Administrare"
                >
                <MenuItem
                    x:Name="ServicesMenu"
                    Header="Servicii și prețuri..."
                    Click="Services_Click"
                    />
                <MenuItem
                    x:Name="BarbersMenu"
                    Header="Frizeri..."
                    Click="Barbers_Click"
                    />
            </MenuItem>
        </Menu>
        <Border
            DockPanel.Dock="Bottom"
            Background="#E6ECEA"
            Padding="24,12"
            >
            <TextBlock
                x:Name="StatusText"
                TextWrapping="Wrap"
                />
        </Border>
        <Grid
            Margin="24"
            RowDefinitions="Auto,Auto,Auto,Auto,*"
            RowSpacing="16"
            >
            <StackPanel
                Spacing="5"
                >
                <TextBlock
                    Text="Tura Barbershop"
                    Classes="heading"
                    />
                <TextBlock
                    Text="Programări la frizerie • Program zilnic 09:00–18:00"
                    Foreground="#52635E"
                    />
            </StackPanel>
            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="10"
                >
                <TextBlock
                    Text="Lista programărilor"
                    FontSize="18"
                    VerticalAlignment="Center"
                    />
                <Button
                    Grid.Column="1"
                    x:Name="AddButton"
                    Content="+ Adaugă"
                    Classes="primary"
                    Click="Add_Click"
                    />
                <Button
                    Grid.Column="2"
                    x:Name="EditButton"
                    Content="Editează"
                    IsEnabled="False"
                    Click="Edit_Click"
                    />
                <Button
                    Grid.Column="3"
                    x:Name="DeleteButton"
                    Content="Șterge"
                    IsEnabled="False"
                    Click="Delete_Click"
                    />
            </Grid>
            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,150,150,Auto"
                ColumnSpacing="12"
                >
                <StackPanel
                    Spacing="5"
                    >
                    <TextBlock
                        Text="Caută client / telefon"
                        />
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Numele clientului..."
                        TextChanged="Filter_Changed"
                        />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Spacing="5"
                    >
                    <TextBlock
                        Text="Frizer"
                        />
                    <ComboBox
                        x:Name="BarberFilter"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="Filter_Changed"
                        />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Spacing="5"
                    >
                    <TextBlock
                        Text="Stare"
                        />
                    <ComboBox
                        x:Name="StateFilter"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="Filter_Changed"
                        >
                        <ComboBoxItem
                            Content="Toate stările"
                            />
                        <ComboBoxItem
                            Content="Programată"
                            />
                        <ComboBoxItem
                            Content="Finalizată"
                            />
                        <ComboBoxItem
                            Content="Anulată"
                            />
                    </ComboBox>
                </StackPanel>
                <StackPanel
                    Grid.Column="3"
                    Spacing="5"
                    >
                    <TextBlock
                        Text="Data programării"
                        />
                    <DatePicker
                        x:Name="DateFilter"
                        SelectedDateChanged="DateFilter_Changed"
                        />
                    <CheckBox
                        x:Name="AllDatesCheck"
                        Content="Toate datele"
                        IsCheckedChanged="AllDates_Changed"
                        />
                </StackPanel>
            </Grid>
            <Border
                Grid.Row="3"
                Background="#E6ECEA"
                Padding="14,10"
                >
                <StackPanel
                    Spacing="6"
                    >
                    <TextBlock
                        Text="Rezumatul listei filtrate"
                        FontWeight="SemiBold"
                        />
                    <TextBlock
                        x:Name="SummaryText"
                        TextWrapping="Wrap"
                        />
                </StackPanel>
            </Border>
            <Grid
                Grid.Row="4"
                >
                <ListBox
                    x:Name="AppointmentList"
                    SelectionChanged="AppointmentList_SelectionChanged"
                    Background="White"
                    BorderBrush="#D5DEDA"
                    BorderThickness="1"
                    >
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            x:DataType="models:Appointment"
                            >
                            <StackPanel
                                Margin="8"
                                Spacing="6"
                                >
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    />
                                <TextBlock
                                    Text="{Binding Details}"
                                    Foreground="#52635E"
                                    TextWrapping="Wrap"
                                    />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="EmptyText"
                    Text="Nu există programări pentru filtrele alese."
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
