<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="BarberDesk.Views.ConfirmWindow"
    Title="Confirmare"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    >
    <StackPanel
        Margin="24"
        Spacing="20"
        >
        <TextBlock
            x:Name="MessageText"
            TextWrapping="Wrap"
            />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10"
            >
            <Button
                x:Name="NoButton"
                Content="Nu"
                Click="No_Click"
                />
            <Button
                x:Name="YesButton"
                Content="Da"
                Classes="primary"
                Click="Yes_Click"
                />
        </StackPanel>
    </StackPanel>
</Window>
